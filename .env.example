# =============================================================================
# whatsapp-bot-openwa — Environment Variables (example)
# =============================================================================
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
# =============================================================================

# --- OpenWA container ---
OPENWA_PORT=2785

# --- Shared Docker network (must already exist: `docker network create shared-network`) ---
SHARED_NETWORK_NAME=shared-network

# --- Existing PostgreSQL instance being reused (fill in which of your 2 instances) ---
# Use the container's service name as defined in the EXISTING project's docker-compose.yml
# (containers on the same Docker network resolve each other by service/container name).
EXISTING_POSTGRES_HOST=REPLACE_WITH_EXISTING_POSTGRES_CONTAINER_NAME
EXISTING_POSTGRES_PORT=5432

# --- Isolated database + user for THIS project only (created via scripts/init-db.sql) ---
# These credentials must NOT be shared with any other project using the same
# Postgres instance. Generate a strong unique password.
OPENWA_DB_NAME=openwa_bot
OPENWA_DB_USER=openwa_user
OPENWA_DB_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD

# --- OpenWA API key (generated by OpenWA on first run, or created via its API) ---
# Used by n8n's HTTP Request nodes to authenticate against OpenWA.
OPENWA_API_KEY=REPLACE_AFTER_FIRST_RUN

# --- LLM provider (for the AI Agent in n8n) ---
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY
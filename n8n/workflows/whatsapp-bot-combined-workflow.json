            ],
            "parameters": {}
        },
        {
            "id": "set-extract-001",
            "name": "Extract Message Data",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                -960,
                820
            ],
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "e1",
                            "name": "sessionId",

        },
        {
            "id": "memory-001",
            "name": "Conversation Memory",
            "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
            "typeVersion": 1.3,
            "position": [
                460,
                850
            ],
            "parameters": {
                "sessionIdType": "customKey",
                "sessionKey": "={{ $json.chatId }}",
                "contextWindowLength": 5
            }
        },
        {
            "id": "agent-001",
            "name": "AI Agent",
            "type": "@n8n/n8n-nodes-langchain.agent",
            "typeVersion": 1.7,
            "position": [
                660,
                850
            ],
            "parameters": {
                "promptType": "define",
                "text": "={{ $json.userMessage }}",
                "options": {
                    "systemMessage": "=You are the official WhatsApp assistant for [Company Name]. Use the 'company_knowledge_base' tool to answer factual questions about the company, products, and policies. Do not make up information not found in the tool or the context below.\n\n{{ $json.conversationHistory }}\n\nCustomer status: {{ $json.customerContext }}\n\nInstructions:\n- If this is a returning customer with order history, feel free to reference their orders naturally (e.g. order status) when relevant to their question.\n- Keep replies concise and conversational, suitable for WhatsApp.\n- If you don't know the answer, say you'll connect them with a human agent rather than guessing.\n- Reply in the same language the user wrote in."
                }
            }
        },
        {
            "id": "http-send-001",
            "name": "Send Reply via OpenWA",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                880,
                850
            ],
            "parameters": {
                "method": "POST",
                "url": "=http://openwa:2785/api/sessions/{{ $('Extract Message Data').item.json.sessionId }}/messages/send-text",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ { \"chatId\": $('Extract Message Data').item.json.chatId, \"text\": $json.output } }}",
                "options": {}
            },
            "credentials": {
                "httpHeaderAuth": {
                    "id": "REPLACE_ME",
                    "name": "OpenWA API Key"
                }
            }
        },
        {
            "id": "pg-log-001",
            "name": "Log Conversation",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.5,
            "position": [
                1080,
                850
            ],
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO conversations (chat_id, from_number, session_id, user_message, bot_reply, created_at)\nVALUES ('{{ $('Extract Message Data').item.json.chatId }}', '{{ $('Extract Message Data').item.json.from }}', '{{ $('Extract Message Data').item.json.sessionId }}', '{{ $('Extract Message Data').item.json.userMessage }}', '{{ $json.output }}', now());",
                "options": {}
            },
            "credentials": {
                "postgres": {
                    "id": "REPLACE_ME",
                    "name": "OpenWA Postgres (isolated)"
                }
            }
        }
    ],
    "connections": {
        "KB Ingestion Schedule": {
            "main": [
                [
                    {
                        "node": "Define KB File List",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Define KB File List": {
            "main": [
                [
                    {
                        "node": "Route by KB Type",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Route by KB Type": {
            "main": [
                [
                    {
                        "node": "Read KB File (Embed)",
                        "type": "main",

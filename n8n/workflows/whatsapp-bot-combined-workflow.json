                }
            }
        },
        {
            "id": "chatmodel-001",
            "name": "Chat Model",
            "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
            "typeVersion": 1.2,
            "position": [
                460,
                700
            ],
            "parameters": {
                "model": "gpt-4o-mini",
                "options": {
                    "temperature": 0.3
                }
            },

            "typeVersion": 1,
            "position": [
                460,
                980
            ],
            "parameters": {
                "mode": "retrieve-as-tool",
                "tableName": "kb_embeddings",
                "toolName": "company_knowledge_base",
                "toolDescription": "Search company FAQs and product info to answer customer questions accurately.",
                "topK": 4,
                "options": {}
            },
            "credentials": {
                "postgres": {
                    "id": "REPLACE_ME",

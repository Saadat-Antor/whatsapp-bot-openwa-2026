        {
            "parameters": {
                "jsCode": "// Turns each CSV row into a text chunk + metadata for embedding.\n// Handles both customer_qnas.csv (Category, Question, Answer, Reference_URL)\n// and product_info.csv (product_name, category, description, price, sku, availability).\nconst items = $input.all();\nconst out = [];\n\nfor (const item of items) {\n  const row = item.json;\n  let pageContent = '';\n\n  if (row.Question || row.question) {\n    const q = row.Question || row.question;\n    const a = row.Answer || row.answer;\n    const cat = row.Category || row.category || '';\n    pageContent = `Category: ${cat}\\nQ: ${q}\\nA: ${a}`;\n  } else if (row.product_name) {\n    pageContent = `Product: ${row.product_name}\\nCategory: ${row.category || ''}\\nDescription: ${row.description || ''}\\nPrice: ${row.price || ''}\\nSKU: ${row.sku || ''}\\nAvailability: ${row.availability || ''}`;\n  } else {\n    // Fallback: dump all columns\n    pageContent = Object.entries(row).map(([k, v]) => `${k}: ${v}`).join('\\n');\n  }\n\n  out.push({\n    json: {\n      pageContent,\n      metadata: { source: $('Define KB File List').first().json.fileName, sourceLabel: $('Define KB File List').first().json.sourceLabel }\n    }\n  });\n}\n\nreturn out;"
            },

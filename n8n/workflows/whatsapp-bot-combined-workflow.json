        {
            "id": "pg-history-001",
            "name": "Fetch Conversation History",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.5,
            "position": [
                -740,
                720
            ],
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT user_message, bot_reply, created_at FROM conversations WHERE chat_id = '{{ $json.chatId }}' ORDER BY created_at DESC LIMIT 10;",
                "options": {}
            },
            "credentials": {
                "postgres": {
                    "id": "REPLACE_ME",
                    "name": "OpenWA Postgres (isolated)"
                }
            }
        },
        {
            "id": "code-format-history-001",
            "name": "Format Conversation History",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -540,
                720
            ],
            "parameters": {
                "jsCode": "const rows = $input.all();\nlet text = 'No previous conversation history. This is a new conversation.';\n\nif (rows.length > 0) {\n  const ordered = [...rows].reverse();\n  text = 'Recent conversation history with this customer:\\n' + ordered.map(r => `- Customer: ${r.json.user_message}\\n- Bot: ${r.json.bot_reply}`).join('\\n');\n}\n\nreturn [{\n  json: {\n    conversationHistory: text,\n    chatId: $('Extract Message Data').first().json.chatId,\n    sessionId: $('Extract Message Data').first().json.sessionId,\n    from: $('Extract Message Data').first().json.from,\n    userMessage: $('Extract Message Data').first().json.userMessage\n  }\n}];"
            }
        },
        {
            "id": "pg-orders-lookup-001",
            "name": "Lookup Customer Orders",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.5,
            "position": [
                -740,
                980
            ],
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT order_id, product_name, quantity, order_status, order_date FROM orders WHERE phone_number = '{{ $json.from }}' ORDER BY order_date DESC LIMIT 5;",
                "options": {}
            },
            "credentials": {
                "postgres": {
                    "id": "REPLACE_ME",
                    "name": "OpenWA Postgres (isolated)"
                }
            }
        },
        {
            "id": "code-customer-context-001",
            "name": "Build Customer Context",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -540,
                980
            ],
            "parameters": {
                "jsCode": "const orders = $input.all();\nconst isReturning = orders.length > 0;\n\nlet summary = 'No prior order history found for this number.';\nif (isReturning) {\n  summary = 'This customer has prior orders:\\n' + orders.map(o => `- Order ${o.json.order_id}: ${o.json.product_name} x${o.json.quantity}, status: ${o.json.order_status}, date: ${o.json.order_date}`).join('\\n');\n}\n\nreturn [{ json: { customerType: isReturning ? 'returning' : 'new', ordersSummary: summary } }];"
            }
        },
        {
            "id": "switch-customer-001",
            "name": "Route by Customer Type",
            "type": "n8n-nodes-base.switch",
            "typeVersion": 3,
            "position": [
                -340,
                980
            ],
            "parameters": {
                "rules": {
                    "values": [
                        {
                            "outputKey": "returning",
                            "conditions": {
                                "options": {
                                    "caseSensitive": true,
                                    "typeValidation": "loose"
                                },
                                "combinator": "and",
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.customerType }}",
                                        "rightValue": "returning",
                                        "operator": {
                                            "type": "string",
                                            "operation": "equals"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "outputKey": "new",
                            "conditions": {
                                "options": {
                                    "caseSensitive": true,
                                    "typeValidation": "loose"
                                },
                                "combinator": "and",
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.customerType }}",
                                        "rightValue": "new",
                                        "operator": {
                                            "type": "string",
                                            "operation": "equals"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                },
                "options": {}
            }
        },
        {

        {
            "parameters": {
                "jsCode": "const item = $input.item;\nlet text = item.json.output;\nlet hasOrder = false;\nlet orderData = {};\n\nconst match = text.match(/\\|\\|\\|ORDER:(\\{.*?\\})\\|\\|\\|/);\nif (match) {\n    hasOrder = true;\n    try {\n        orderData = JSON.parse(match[1]);\n    } catch (e) {\n        orderData = { error: \"Failed to parse intent JSON\", raw: match[1] };\n    }\n    text = text.replace(/\\|\\|\\|ORDER:(\\{.*?\\})\\|\\|\\|/, '').trim();\n}\n\nreturn {\n    json: {\n        output: text,\n        hasOrder: hasOrder,\n        orderData: orderData,\n        from: $('Extract Message Data').first().json.from\n    }\n};"
            },
            "id": "613083c8-cbbb-4a55-aeaf-bd0e241c0c50",
            "name": "Parse Order Intent",

                -496,
                4576
            ]
        },
        {
            "parameters": {
                "jsCode": "const orders = $input.all();\n\n// Verify we have items AND the first item actually contains a real database order_id\nconst isReturning = orders.length > 0 && orders[0].json.order_id !== undefined;\n\nlet summary = 'No prior order history found for this number.';\nif (isReturning) {\n  summary = 'This customer has prior orders:\\n' + orders.map(o => `- Order ${o.json.order_id}: ${o.json.product_name} x${o.json.quantity}, status: ${o.json.order_status}, date: ${o.json.order_date}`).join('\\n');\n}\n\nreturn [{ json: { customerType: isReturning ? 'returning' : 'new', ordersSummary: summary } }];"
            },

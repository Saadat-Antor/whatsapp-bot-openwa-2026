        {
            "id": "pg-upsert-orders-001",
            "name": "Upsert Orders Table",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.5,
            "position": [
                -340,
                460
            ],
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO orders (phone_number, order_id, product_name, quantity, order_status, order_date, updated_at)\nVALUES ('{{ $json.phone_number }}', '{{ $json.order_id }}', '{{ $json.product_name }}', {{ $json.quantity || 1 }}, '{{ $json.order_status }}', '{{ $json.order_date }}', now())\nON CONFLICT (phone_number, order_id)\nDO UPDATE SET product_name = EXCLUDED.product_name, quantity = EXCLUDED.quantity, order_status = EXCLUDED.order_status, order_date = EXCLUDED.order_date, updated_at = now();",
                "options": {}
            },
            "credentials": {
                "postgres": {
                    "id": "REPLACE_ME",
                    "name": "OpenWA Postgres (isolated)"
                }
            }
        },
        {
            "id": "merge-ingest-001",
            "name": "Merge Ingestion Branches",
            "type": "n8n-nodes-base.merge",
            "typeVersion": 3,
            "position": [
                80,
                300
            ],
            "parameters": {
                "mode": "append",
                "options": {}
            }
        },
        {
            "id": "noop-ingest-done-001",
            "name": "KB Ingestion Complete",
            "type": "n8n-nodes-base.noOp",

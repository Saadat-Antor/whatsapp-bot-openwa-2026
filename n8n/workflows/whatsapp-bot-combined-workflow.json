                "operation": "executeQuery",
                "query": "INSERT INTO order_intake_queue (phone_number, extracted_json, processed)\nSELECT \n  '+{{ $json.from.replace(\"@c.us\", \"\") }}',\n  '{{ JSON.stringify($json.orderData) }}'::jsonb,\n  FALSE\nWHERE {{ $json.hasOrder }} = TRUE;",
                "options": {}
            },
            "id": "62024b8f-d3af-4471-a2ca-dcc02fa4e6e7",
            "name": "Conditional Staging Insert",
            "type": "n8n-nodes-base.postgres",
